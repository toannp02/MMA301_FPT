{
  "name": "artspace-ar",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@reactvision/react-viro": "3.0.3",
    "base64-js": "^1.5.1",
    "expo": "57.0.31",
    "expo-asset": "~57.0.20",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "12.14.0",
    "jpeg-js": "^0.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^15.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "test": "jest",
    "android": "expo run:android",
    "lint": "eslint .",
    "start": "expo start --dev-client",
    "web": "expo start --web --port 8081",
    "doctor": "npx expo-doctor@1.21.5",
    "test:rules": "firebase emulators:exec --project demo-artspace-ar --only firestore,storage \"node --test firebase/tests/rules.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "start:iphone": "npm --prefix apps/iphone-expo-go start",
    "setup:iphone": "npm --prefix apps/iphone-expo-go ci",
    "check:iphone": "npm --prefix apps/iphone-expo-go run typecheck"
  },
  "private": true,
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts",
      "<rootDir>/tests/**/*.test.tsx"
    ],
    "preset": "jest-expo",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "node",
        "node-addons"
      ]
    }
  }
}
