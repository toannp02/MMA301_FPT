{
  "name": "artspace-ar",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "base64-js": "^1.5.1",
    "expo": "58.0.20",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "jpeg-js": "^0.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.0",
    "expo-system-ui": "~58.0.6"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go --lan --port 8082 --max-workers 2",
    "android": "expo start --go --android",
    "web": "expo start --web --port 8082 --max-workers 2",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "doctor": "npx expo-doctor@1.21.5",
    "verify": "node scripts/verify.mjs",
    "check:bundle": "node scripts/check-expo-go.mjs"
  },
  "private": true,
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts",
      "<rootDir>/tests/**/*.test.tsx"
    ],
    "preset": "jest-expo",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "node",
        "node-addons"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/artifacts/",
      "<rootDir>/dist/"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/app",
      "<rootDir>/tests"
    ],
    "transform": {
      "^.+\\.(bmp|gif|jpg|jpeg|mp4|png|psd|svg|webp)$": "jest-expo/src/preset/assetFileTransformer.js"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ]
  }
}
